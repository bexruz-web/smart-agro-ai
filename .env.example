# ========== Smart Agro AI — muhit o'zgaruvchilari ==========
# Bu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring:  cp .env.example .env
# .env hech qachon git'ga yoki chatga qo'yilmaydi!

# --- Umumiy
# development | production
APP_ENV=production
# hakamlar uchun demo kirish (/auth/demo) va demo ssenariylari
DEMO_MODE=true
LOG_LEVEL=INFO
TZ=Asia/Tashkent

# --- Domen (HTTPS majburiy: Telegram Mini App faqat HTTPS'da ochiladi)
DOMAIN=agro.example.uz
WEBAPP_URL=https://agro.example.uz/

# --- Ma'lumotlar bazasi (docker-compose ichida)
POSTGRES_USER=smartagro
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=smartagro
DATABASE_URL=postgresql+asyncpg://smartagro:change-me-strong-password@db:5432/smartagro
REDIS_URL=redis://redis:6379/0

# --- Xavfsizlik (uzun tasodifiy qatorlar: `openssl rand -hex 32`)
JWT_SECRET=change-me
INTERNAL_API_TOKEN=change-me
# vergul bilan: 123456789,987654321
ADMIN_TELEGRAM_IDS=

# --- Telegram (@BotFather'dan)
TELEGRAM_BOT_TOKEN=
# faqat A-Z a-z 0-9 _ - belgilari
TELEGRAM_WEBHOOK_SECRET=change-me
# polling (oddiy) | webhook (prod, HTTPS kerak)
BOT_MODE=polling
ADMIN_CHAT_ID=

# --- AI (Anthropic Console: https://console.anthropic.com). Bo'sh bo'lsa — AI'siz qoidalar rejimi.
ANTHROPIC_API_KEY=
# Gemini ishlatilsa: GEMINI_API_KEY to'ldiring va AI_MODEL=gemini-3.5-flash qo'ying
GEMINI_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT_ANALYSIS=medium
AI_EFFORT_CHAT=low
CHAT_DAILY_LIMIT=30

# --- Mini App build (Vite) — xarita
# leaflet (kalitsiz) | google
VITE_MAP_PROVIDER=leaflet
# Google Cloud'da HTTP referrer bo'yicha cheklang!
VITE_GOOGLE_MAPS_API_KEY=
VITE_ALLOW_DEMO=true

# --- Monitoring
REPORT_INTERVAL_HOURS=4
EXPECTED_SENSOR_INTERVAL_MIN=15
ALERT_COOLDOWN_HOURS=6
