# Smart Agro AI — Mini App build-time variables (Vite inlines VITE_* at build time).
# Copy to .env.local for local development.

# Base URL of the backend REST API. Same origin in production (nginx proxies /api).
# In dev, Vite proxies /api and /tg to http://localhost:8000 (override with VITE_DEV_BACKEND).
VITE_API_BASE=/api/v1

# Map provider: "leaflet" (default; Esri World Imagery satellite tiles, no key needed)
# or "google" (requires VITE_GOOGLE_MAPS_API_KEY; falls back to leaflet if the key is empty).
VITE_MAP_PROVIDER=leaflet

# Google Maps JavaScript API key (only used when VITE_MAP_PROVIDER=google).
# It is visible in the frontend bundle: restrict it by HTTP referrer / domain in Google Cloud Console (MAP-6).
VITE_GOOGLE_MAPS_API_KEY=

# Optional Google Maps Map ID (vector map / cloud styling). Leave empty for the default raster map.
VITE_GOOGLE_MAPS_MAP_ID=

# Show the "Demo rejimida kirish" button when the app is opened outside Telegram
# (backend must run with DEMO_MODE=true). Set to "false" to hide it in production.
VITE_ALLOW_DEMO=true

# Theme: "light" (default) = brand light palette always, even in Telegram dark mode.
# "auto" = use the dark variant when Telegram / the OS is in dark mode.
VITE_THEME_MODE=light

# Dev only: backend address for the Vite proxy (not used in production builds).
# VITE_DEV_BACKEND=http://localhost:8000
